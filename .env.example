# ============================================================
# LOCAL DEVELOPMENT — copy this file to .env and adjust
# ============================================================

# Local SQLite database (for development)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-american-space-oujda-2026-change-in-production

# ============================================================
# PRODUCTION (Cloudflare Pages + Turso) — set these in Cloudflare dashboard
# ============================================================
#
# DATABASE_URL          = libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN   = your-turso-auth-token
# NEXTAUTH_URL          = https://your-app.pages.dev  (or your custom domain)
# NEXTAUTH_SECRET       = (generate with: openssl rand -base64 32)
#
# Do NOT commit your real .env file to git. The .gitignore already excludes it.
