// Prisma schema — American Space Oujda
// Uses libSQL adapter at runtime (see src/lib/db.ts).
// The datasource URL below is only used by `prisma generate` at build time.
// At runtime, the adapter in src/lib/db.ts handles the actual connection.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/placeholder.db"
}

// ============================================================
// AUTH & USERS
// ============================================================

enum Role {
  ADMIN
  TEACHER
  EDITOR
  LIBRARY
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?  // bcrypt hash; null for OAuth-only accounts
  role          Role     @default(TEACHER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  coursesTaught Course[]
  reports       Report[]
  accounts      Account[]
  sessions      Session[]

  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// EXISTING: APPLICATIONS, EVENTS, GALLERY, COMMENTS, MEMBERSHIP, COURSE REGISTRATIONS
// ============================================================

model Application {
  id        String   @id @default(cuid())
  role      String   // TEACHER | VOLUNTEER | INTERN | TRAINER
  fullName  String
  email     String
  phone     String?
  age       Int?
  city      String?
  country   String?
  occupation String?
  organization String?
  languages String?
  availability String?
  motivation String?
  experience String?
  references String?
  startDate String?
  duration  String?
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // WORKSHOP | LECTURE | CLUB | CULTURAL | COURSE | OTHER
  startDate   DateTime
  endDate     DateTime?
  location    String?
  capacity    Int?
  registered  Int      @default(0)
  imageUrl    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([category])
  @@index([featured])
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String   @default("general")
  eventDate   DateTime?
  createdAt   DateTime @default(now())

  @@index([category])
}

model Comment {
  id        String   @id @default(cuid())
  name      String
  email     String?
  subject   String
  message   String
  category  String   @default("general")
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status])
}

model Membership {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  type      String   // STUDENT | PROFESSIONAL | SENIOR | FAMILY
  duration  String   // MONTHLY | QUARTERLY | ANNUAL
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([email])
}

model CourseRegistration {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  level     String   // BEGINNER | ELEMENTARY | INTERMEDIATE | ADVANCED | CONVERSATION | TOEFL | IELTS
  slot      String?
  notes     String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([level])
}

// Legacy admin model — kept for backwards compatibility, replaced by User
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

// ============================================================
// NEW: COURSES, ENROLLMENTS, ATTENDANCE, GRADES, REPORTS
// ============================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  level       String   // BEGINNER | ELEMENTARY | INTERMEDIATE | ADVANCED | CONVERSATION | TOEFL | IELTS
  schedule    String   // e.g. "Mon & Wed · 18:00–20:00"
  startDate   DateTime
  endDate     DateTime?
  capacity    Int      @default(20)
  active      Boolean  @default(true)
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  attendances Attendance[]
  grades      Grade[]
  reports     Report[]

  @@index([teacherId])
  @@index([level])
  @@index([active])
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  studentName  String
  studentEmail String
  studentPhone String?
  level     String
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED
  enrolledAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studentEmail])
  @@unique([courseId, studentEmail])
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  date      DateTime
  studentEmail String
  studentName  String
  status    String   // PRESENT | ABSENT | LATE | EXCUSED
  notes     String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, date, studentEmail])
  @@index([courseId, date])
}

model Grade {
  id        String   @id @default(cuid())
  courseId  String
  studentEmail String
  studentName  String
  title     String   // e.g. "Midterm Exam", "Homework 1"
  score     Float
  maxScore  Float
  weight    Float    @default(1.0) // e.g. 0.3 for 30% of final grade
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, studentEmail])
}

model Report {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  period    String   // e.g. "October 2026", "Fall 2026 Midterm"
  summary   String
  challenges String?
  recommendations String?
  submittedAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([teacherId])
}

// ============================================================
// NEW: SITE SETTINGS (mini-CMS for editable page content)
// ============================================================

model SiteSetting {
  key       String   @id
  value     String
  category  String   @default("general") // contact | hours | hero | about | etc.
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ============================================================
// EDITABLE CONTENT — Clubs, Useful Links, Page Content
// ============================================================

model Club {
  id          String   @id @default(cuid())
  name        String
  description String
  schedule    String
  iconName    String   @default("Users") // Lucide icon name
  colorClass  String   @default("bg-sky-500/10 text-sky-700 dark:text-sky-300")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model SiteLink {
  id          String   @id @default(cuid())
  name        String
  description String
  url         String
  iconName    String   @default("Link2")
  category    String   @default("partner") // partner | resource | embassy
  createdAt   DateTime @default(now())

  @@index([category])
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   String   @unique // "home.hero.title" | "about.intro" | etc.
  section   String   // "hero" | "intro" | "stats" | etc.
  content   String   // text content (could be JSON for structured data)
  updatedAt DateTime @updatedAt

  @@index([pageKey])
  @@index([section])
}
